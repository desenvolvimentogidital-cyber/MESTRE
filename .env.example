# Supabase - use a chave publishable no frontend.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Compatibilidade com projetos antigos (use somente se não tiver a publishable key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Nunca coloque service_role ou secret key em variáveis NEXT_PUBLIC_.
